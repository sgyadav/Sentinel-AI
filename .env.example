# Application Configuration
APP_NAME=SENTINEL AI
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=sqlite:////data/sentinel.db
# For production, use: DATABASE_URL=postgresql://user:password@db:5432/sentinel

# JWT Security Configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set only for first startup when the admin account does not exist yet.
SENTINEL_INITIAL_ADMIN_PASSWORD=

# Shared high-entropy bearer token used only by endpoint agents (minimum 32 characters).
SENTINEL_AGENT_TOKEN=

# CORS Configuration
# Set this to the exact hosted frontend origin in Render, for example:
# SENTINEL_CORS_ORIGINS=https://your-project.vercel.app
# Local development can use http://localhost:5173 (see README.md).
SENTINEL_CORS_ORIGINS=

# Security
REQUIRE_HTTPS=False
PASSWORD_MIN_LENGTH=8

# Real-time Processing
REALTIME_ENABLED=True
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Telemetry
HEARTBEAT_TIMEOUT=120

# Threat Intelligence APIs (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OTX_API_KEY=your_otx_api_key_here

# Email (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Logging
LOG_LEVEL=INFO
